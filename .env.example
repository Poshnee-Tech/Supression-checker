# ---------------------------------------------------------------------------
# Suppression Checker - environment variables
#
# Copy to .env.local for local development and set the same variables in the
# Vercel project (Settings -> Environment Variables). NEVER commit real values.
# Every variable here is server-only: none is prefixed NEXT_PUBLIC_, so none
# of them is ever included in the browser bundle.
# ---------------------------------------------------------------------------

# --- Authentication --------------------------------------------------------

# Signing key for the session JWT. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Application users as a single-line JSON array.
# Generate each passwordHash with:  npm run hash-password -- --user agent1
#
# IMPORTANT - local .env files only: dotenv treats "$" as variable
# interpolation, so every "$" in a bcrypt hash must be escaped as "\$" here.
# Vercel environment variables are NOT interpolated - paste the hash as-is there.
#
# APP_USERS=[{"username":"agent1","passwordHash":"\$2a\$12\$abcdefghijklmnopqrstuv0123456789012345678901234567890","role":"agent"}]
APP_USERS=

# --- Buyer suppression API (TLD CRM) ---------------------------------------
#
# The app calls:
#   GET {TLD_BASE_URL}/api/public/dialer/ready/{phone11}?fpg={TLD_FPG}

TLD_BASE_URL=https://enrollppi.tldcrm.com

# Comma-separated suppression filter groups to screen against.
# REQUIRED and must be non-empty: with no filter groups the upstream replies
# {"ready":0,"reason":"PAR"} for EVERY number, which would look like a
# universal "do not transfer". The app reports that case as ERROR, not FAIL.
TLD_FPG=CLIENTS,ECLIENTS,BLOCK,EBLOCK,OCLIENTS

# --- Upstash Redis (rate limiting + audit log) -----------------------------
# Create a database at https://console.upstash.com and copy the REST
# credentials. Without these, rate limiting and audit logging are disabled.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
